{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/animations/(.*)",
      "dest": "/public/animations/$1"
    },
    {
      "src": "/(favicon.*|robots.txt|apple-touch-icon.png)",
      "dest": "/public/$1"
    },
    {
      "src": "/clear-cookies.html",
      "dest": "/public/clear-cookies.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_KEY": "base64:SGe084z0okoksW0WXyFebDKAZ9umXMfWnYBVU79MTlI=",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_CONNECTION": "sqlite",
    "APP_MAINTENANCE_DRIVER": "file",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "database",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_COOKIE": "rentbohol_session",
    "APP_URL": "https://mystarup-carrental.vercel.app",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "HASH_DRIVER": "bcrypt",
    "BCRYPT_ROUNDS": "10"
  }
}
